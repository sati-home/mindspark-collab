# docker/.env.example - copy to docker/.env
# Required. Generate: openssl rand -hex 32
AUTH_SECRET=
# Self-hosted forge origins the session endpoint may verify tokens against (comma-separated).
ALLOWED_INSTANCES=https://gitlab.example.com
# Host name traefik routes to this container.
COLLAB_HOST=mindspark.example.com
# Behind traefik every request comes from the proxy; key rate limits on the forwarded client instead.
TRUST_PROXY=1
# Uncomment to refuse anonymous room writes and live joins (company setting; legacy anonymous links stop working).
# REQUIRE_IDENTITY=1
# Only when the app is hosted elsewhere:
# ALLOWED_ORIGIN=https://app.example
